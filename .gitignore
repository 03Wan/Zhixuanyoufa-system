# Vercel
.vercel/
**/.vercel/

# Environment files (keep examples)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Dependencies
node_modules/
**/node_modules/

# Build outputs and caches
dist/
**/dist/
.vite/
**/.vite/
.playwright-cli/
*.tsbuildinfo

# Generated frontend source artifacts
frontend+/src/**/*.js
frontend+/src/**/*.d.ts
!frontend+/src/env.d.ts
frontend+/src/**/*.bak

# Local operations notes
docs/*.local.md

# Runtime data
uploads/
**/uploads/
.server.pid
**/.server.pid
*.log

# OS and editor junk
.DS_Store
Thumbs.db
