<template>
  <div class="app-page fade-up">
    <header class="topbar glass">
      <div class="brand">
        <div class="logo">智</div>
        <div>
          <h1>智选优发</h1>
          <p>商品素材评估与发布决策辅助系统</p>
        </div>
      </div>
      <div class="top-actions">
        <div class="user-chip">
          <strong>{{ auth.state.user?.username || "当前用户" }}</strong>
          <small>{{ auth.state.user?.email || "-" }}</small>
        </div>
        <ThemeToggle />
        <button class="btn btn-secondary" @click="showLogout = true">退出登录</button>
      </div>
    </header>

    <div class="layout">
      <aside class="sidebar glass">
        <button v-for="m in menus" :key="m.key" :class="['menu-btn', activeMenu===m.key ? 'active' : '']" @click="activeMenu = m.key">
          <span>{{ m.icon }}</span><span>{{ m.label }}</span>
        </button>
        <div class="version">系统版本 v1.0.0</div>
      </aside>

      <main class="workspace glass">
        <section v-if="activeMenu==='dashboard'" class="stack">
          <h2 class="section-title">工作台</h2>
          <div class="state">请在左侧进入任务中心进行任务管理。</div>
        </section>

        <section v-if="activeMenu==='task'" class="stack">
          <div class="panel-header">
            <h2 class="section-title">任务中心</h2>
            <button class="btn btn-secondary" @click="loadTasks">刷新任务</button>
          </div>

          <section class="panel">
            <h3>新建任务</h3>
            <div class="grid-2">
              <div><label>商品名称 *</label><input class="input" v-model="taskForm.productName" /></div>
              <div><label>商品品类 *</label><input class="input" v-model="taskForm.category" /></div>
              <div><label>目标平台 *</label><select v-model="taskForm.platform"><option value="">请选择</option><option v-for="p in platforms" :key="p" :value="p">{{ p }}</option></select></div>
              <div><label>目标市场 *</label><select v-model="taskForm.market"><option value="">请选择</option><option v-for="m in markets" :key="m" :value="m">{{ m }}</option></select></div>
            </div>
            <div><label>发布目的 *</label><select v-model="taskForm.purpose"><option value="">请选择</option><option v-for="p in purposes" :key="p" :value="p">{{ p }}</option></select></div>
            <div><label>商品标题 *</label><textarea rows="2" v-model="taskForm.title" /></div>
            <div><label>核心卖点 *</label><textarea rows="3" v-model="taskForm.sellingPoints" /></div>
            <div><label>详情页文案 *</label><textarea rows="4" v-model="taskForm.detailText" /></div>
            <div><label>广告语</label><textarea rows="2" v-model="taskForm.adText" /></div>
            <div><label>图片链接（每行一个）*</label><textarea rows="3" v-model="imagesText" /></div>
            <div class="actions-row">
              <button class="btn btn-primary" :disabled="loading.createTask" @click="createTask">
                {{ loading.createTask ? "创建中..." : "创建任务" }}
              </button>
              <span v-if="taskMessage" class="tip">{{ taskMessage }}</span>
            </div>
          </section>

          <section class="panel">
            <h3>任务列表</h3>
            <div class="grid-3">
              <input class="input" v-model="taskFilter.keyword" placeholder="搜索任务名称/品类/平台/市场" />
              <select v-model="taskFilter.status">
                <option value="">全部状态</option>
                <option v-for="s in taskStatusOptions" :key="s.value" :value="s.value">{{ s.label }}</option>
              </select>
              <button class="btn btn-secondary" @click="resetFilter">重置筛选</button>
            </div>

            <div v-if="loading.tasks" class="state">任务加载中...</div>
            <div v-else-if="taskError" class="state error">{{ taskError }}</div>
            <div v-else-if="filteredTasks.length===0" class="state">
              <p>暂无任务，请先新建任务。</p>
              <button class="btn btn-primary" @click="scrollToTop">新建任务</button>
            </div>
            <table v-else class="table">
              <thead>
                <tr>
                  <th>任务编号</th><th>商品名称</th><th>商品品类</th><th>目标平台</th><th>目标市场</th><th>发布目的</th><th>任务状态</th><th>创建时间</th><th>操作</th>
                </tr>
              </thead>
              <tbody>
                <tr v-for="task in filteredTasks" :key="task.id">
                  <td>{{ task.taskNo || shortNo(task.id) }}</td>
                  <td>{{ task.productName }}</td>
                  <td>{{ task.category }}</td>
                  <td>{{ task.platform }}</td>
                  <td>{{ task.market }}</td>
                  <td>{{ task.purpose }}</td>
                  <td><span :class="['tag', statusClass(task.status)]">{{ statusLabel(task.status) }}</span></td>
                  <td>{{ toDate(task.createdAt) }}</td>
                  <td class="op-row">
                    <button class="btn btn-secondary" @click="openDetail(task.id,false)">查看详情</button>
                    <button class="btn btn-secondary" :disabled="isDetecting(task)" @click="startDetect(task)">
                      {{ isDetecting(task) ? "检测中" : rowLoadingId===task.id ? "启动中..." : "启动检测" }}
                    </button>
                    <button class="btn btn-secondary" @click="openDetail(task.id,true)">编辑</button>
                    <button class="btn btn-secondary" @click="prepareDelete(task)">删除</button>
                  </td>
                </tr>
              </tbody>
            </table>
          </section>
        </section>

        <section v-if="activeMenu==='result'" class="stack"><h2 class="section-title">检测结果</h2><div class="state">请在任务详情或任务列表中进入检测结果。</div></section>
        <section v-if="activeMenu==='report'" class="stack"><h2 class="section-title">报告中心</h2><div class="state">请在任务详情中生成报告后查看。</div></section>
        <section v-if="activeMenu==='rule'" class="stack"><h2 class="section-title">规则库</h2><div class="state">规则维护功能保持不变。</div></section>
      </main>
    </div>

    <div v-if="showCreateChoice" class="modal-mask" @click.self="showCreateChoice=false">
      <section class="modal-card glass">
        <div class="row-between"><h3>任务已创建</h3><button class="close-btn" @click="showCreateChoice=false">×</button></div>
        <p class="text-muted">请选择下一步操作：</p>
        <div class="actions-row">
          <button class="btn btn-primary" @click="continueUpload">继续上传素材</button>
          <button class="btn btn-secondary" @click="showCreateChoice=false">返回任务列表</button>
        </div>
      </section>
    </div>

    <div v-if="showDeleteConfirm" class="modal-mask" @click.self="showDeleteConfirm=false">
      <section class="modal-card glass">
        <div class="row-between"><h3>删除确认</h3><button class="close-btn" @click="showDeleteConfirm=false">×</button></div>
        <p class="text-muted">确认删除任务「{{ deleteTarget?.productName || '-' }}」吗？该操作不可恢复。</p>
        <div class="actions-row">
          <button class="btn btn-secondary" @click="showDeleteConfirm=false">取消</button>
          <button class="btn btn-primary" @click="confirmDelete">确认删除</button>
        </div>
      </section>
    </div>

    <div v-if="showLogout" class="modal-mask" @click.self="showLogout=false">
      <section class="modal-card glass">
        <div class="row-between"><h3>退出确认</h3><button class="close-btn" @click="showLogout=false">×</button></div>
        <p class="text-muted">确认退出登录吗？</p>
        <div class="actions-row">
          <button class="btn btn-secondary" @click="showLogout=false">取消</button>
          <button class="btn btn-primary" @click="logout">确认退出</button>
        </div>
      </section>
    </div>
  </div>
</template>

<script setup lang="ts">
import { computed, onMounted, reactive, ref } from "vue";
import { useRouter } from "vue-router";
import ThemeToggle from "@/components/ThemeToggle.vue";
import { api, getFriendlyError } from "@/lib/api";
import { useAuthStore } from "@/stores/auth";

const router = useRouter();
const auth = useAuthStore();
const menus = [
  { key: "dashboard", label: "工作台", icon: "🏠" },
  { key: "task", label: "任务中心", icon: "📁" },
  { key: "result", label: "检测结果", icon: "📊" },
  { key: "report", label: "报告中心", icon: "📄" },
  { key: "rule", label: "规则库", icon: "🧩" },
];
const platforms = ["Amazon", "eBay", "AliExpress", "Shopee", "Lazada", "Temu", "独立站"];
const markets = ["北美", "欧洲", "日本", "东南亚", "中东", "拉美", "澳洲"];
const purposes = ["上架前审核", "广告投放前审核", "活动页面优化", "存量素材复审"];
const taskStatusOptions = [
  { value: "PENDING_DETECTION", label: "待检测" },
  { value: "DETECTING", label: "检测中" },
  { value: "COMPLETED", label: "已完成" },
  { value: "REVIEW_REQUIRED", label: "待复核" },
  { value: "HOLD", label: "暂缓发布" },
];

const activeMenu = ref("task");
const showLogout = ref(false);
const showCreateChoice = ref(false);
const showDeleteConfirm = ref(false);
const rowLoadingId = ref("");
const createdTaskId = ref("");

const loading = reactive({ tasks: false, createTask: false });
const tasks = ref<any[]>([]);
const taskError = ref("");
const taskMessage = ref("");
const deleteTarget = ref<any | null>(null);

const taskFilter = reactive({ keyword: "", status: "" });
const taskForm = reactive({
  productName: "", category: "", platform: "", market: "", purpose: "",
  title: "", sellingPoints: "", detailText: "", adText: "",
});
const imagesText = ref("");

const filteredTasks = computed(() => tasks.value.filter((t) => {
  const kw = taskFilter.keyword.trim().toLowerCase();
  const hitKw = !kw || [t.productName, t.category, t.platform, t.market].some((v: any) => String(v || "").toLowerCase().includes(kw));
  const hitSt = !taskFilter.status || normalizeStatus(t) === taskFilter.status;
  return hitKw && hitSt;
}));

function normalizeStatus(task: any) {
  const decision = String(task?.detectionResult?.decision || "").toUpperCase();
  if (decision.includes("REJECT")) return "HOLD";
  if (decision.includes("OPTIMIZE")) return "REVIEW_REQUIRED";
  return String(task.status || "PENDING_DETECTION").toUpperCase();
}
function statusLabel(status?: string) {
  const map: Record<string, string> = { PENDING_DETECTION: "待检测", DETECTING: "检测中", COMPLETED: "已完成", REVIEW_REQUIRED: "待复核", HOLD: "暂缓发布", DRAFT: "待检测", REPORTED: "已完成" };
  return map[String(status || "").toUpperCase()] || "待检测";
}
function statusClass(status?: string) {
  const s = String(status || "").toUpperCase();
  if (s === "COMPLETED" || s === "REPORTED") return "tag-success";
  if (s === "DETECTING") return "tag-warning";
  if (s === "REVIEW_REQUIRED") return "tag-warning";
  if (s === "HOLD") return "tag-danger";
  return "tag-default";
}
function shortNo(id?: string) { return `TSK-${String(id || "").slice(-6).toUpperCase()}`; }
function toDate(v?: string) { return v ? new Date(v).toLocaleString("zh-CN", { hour12: false }) : "-"; }
function isDetecting(task: any) { return normalizeStatus(task) === "DETECTING"; }

function validateCreate() {
  const required = [taskForm.productName, taskForm.category, taskForm.platform, taskForm.market, taskForm.purpose, taskForm.title, taskForm.sellingPoints, taskForm.detailText, imagesText.value];
  return required.every((x) => String(x || "").trim());
}

async function loadTasks() {
  loading.tasks = true;
  taskError.value = "";
  try { tasks.value = await api.getTaskList(); }
  catch (e) { taskError.value = getFriendlyError(e); }
  finally { loading.tasks = false; }
}

async function createTask() {
  if (!validateCreate()) { taskMessage.value = "请完成必填项后再创建任务。"; return; }
  loading.createTask = true;
  taskMessage.value = "";
  try {
    const created = await api.createTask({
      ...taskForm,
      imageUrls: imagesText.value.split("\n").map((x) => x.trim()).filter(Boolean),
    }) as any;
    createdTaskId.value = created.id;
    taskMessage.value = "任务创建成功。";
    await loadTasks();
    showCreateChoice.value = true;
  } catch (e) {
    taskMessage.value = getFriendlyError(e);
  } finally {
    loading.createTask = false;
  }
}

function continueUpload() {
  showCreateChoice.value = false;
  if (createdTaskId.value) router.push(`/tasks/${createdTaskId.value}?edit=1`);
}
function openDetail(id: string, edit = false) {
  router.push(edit ? `/tasks/${id}?edit=1` : `/tasks/${id}`);
}
async function startDetect(task: any) {
  if (isDetecting(task) || rowLoadingId.value) return;
  rowLoadingId.value = task.id;
  try {
    await api.updateTaskStatus(task.id, "DETECTING");
    await api.analyzeTask(task.id);
    await api.updateTaskStatus(task.id, "COMPLETED");
    await loadTasks();
  } catch (e) {
    taskMessage.value = getFriendlyError(e);
  } finally {
    rowLoadingId.value = "";
  }
}
function prepareDelete(task: any) { deleteTarget.value = task; showDeleteConfirm.value = true; }
async function confirmDelete() {
  if (!deleteTarget.value) return;
  try {
    await api.deleteTask(deleteTarget.value.id);
    showDeleteConfirm.value = false;
    deleteTarget.value = null;
    await loadTasks();
  } catch (e) {
    taskMessage.value = getFriendlyError(e);
  }
}
function resetFilter() { taskFilter.keyword = ""; taskFilter.status = ""; }
function scrollToTop() { window.scrollTo({ top: 0, behavior: "smooth" }); }
function logout() { auth.logout(); router.push("/login"); }

onMounted(async () => {
  auth.syncFromStorage();
  await loadTasks();
});
</script>

<style scoped>
.app-page { min-height: calc(100vh - 36px); display: grid; grid-template-rows: auto 1fr; gap: 14px; }
.topbar { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; }
.brand { display: flex; align-items: center; gap: 10px; }
.logo { width: 38px; height: 38px; border-radius: 10px; background: linear-gradient(135deg, var(--brand-0), var(--brand-1)); color: #fff; font-weight: 800; display: grid; place-items: center; }
.brand h1 { margin: 0; font-size: 30px; }
.brand p { margin: 2px 0 0; color: var(--muted); font-size: 13px; }
.top-actions { display: flex; align-items: center; gap: 8px; }
.user-chip { display: grid; gap: 2px; text-align: right; background: var(--card-strong); border: 1px solid var(--border); border-radius: 10px; padding: 6px 10px; }
.user-chip strong { font-size: 13px; line-height: 1.2; }
.user-chip small { color: var(--muted); font-size: 12px; line-height: 1.2; }

.layout { display: grid; grid-template-columns: 220px 1fr; gap: 14px; }
.sidebar { padding: 14px; display: flex; flex-direction: column; gap: 8px; }
.menu-btn { border: 1px solid var(--border); background: var(--card-strong); color: var(--text); border-radius: 10px; padding: 10px 12px; display: flex; gap: 8px; align-items: center; cursor: pointer; text-align: left; transition: .2s ease; }
.menu-btn.active { background: linear-gradient(135deg, rgba(37,99,235,.15), rgba(6,182,212,.16)); border-color: rgba(37,99,235,.42); font-weight: 700; }
.version { margin-top: auto; font-size: 12px; color: var(--muted); border: 1px solid var(--border); border-radius: 10px; padding: 6px 8px; background: var(--card-strong); }

.workspace { padding: 16px; align-content: start; display: grid; }
.stack { display: grid; gap: 12px; }
.section-title { margin: 0; }
.panel { border: 1px solid var(--border); border-radius: 14px; background: var(--card-strong); padding: 12px; }
.panel-header { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
.grid-2 { display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }
.grid-3 { display: grid; gap: 10px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
.actions-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.state { border: 1px dashed var(--border); border-radius: 10px; padding: 14px; color: var(--muted); background: var(--card-strong); }
.state.error { color: #ef4444; }
.tip { color: var(--brand-1); margin: 0; }
.op-row { display: flex; gap: 8px; flex-wrap: wrap; }
.tag { display: inline-flex; align-items: center; border-radius: 999px; padding: 2px 10px; font-size: 12px; font-weight: 700; border: 1px solid transparent; }
.tag-default { background: var(--card-strong); color: var(--muted); border-color: var(--border); }
.tag-success { background: rgba(16, 185, 129, .12); color: #047857; border-color: rgba(16, 185, 129, .28); }
.tag-warning { background: rgba(245, 158, 11, .12); color: #b45309; border-color: rgba(245, 158, 11, .28); }
.tag-danger { background: rgba(239, 68, 68, .12); color: #b91c1c; border-color: rgba(239, 68, 68, .28); }

.table { width: 100%; border-collapse: collapse; }
.table th, .table td { border-bottom: 1px solid var(--border); padding: 10px 8px; text-align: left; vertical-align: top; }
.table th { color: var(--muted); font-weight: 600; }

.modal-mask { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.35); display: grid; place-items: center; z-index: 1000; }
.modal-card { width: min(90vw, 420px); padding: 14px; border-radius: 14px; display: grid; gap: 10px; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.close-btn { border: 0; background: transparent; font-size: 28px; line-height: 1; cursor: pointer; color: var(--muted); }
.close-btn:hover { color: var(--text); }

@media (max-width: 1100px) {
  .layout { grid-template-columns: 1fr; }
  .sidebar { flex-direction: row; flex-wrap: wrap; }
  .version { width: 100%; }
  .grid-2, .grid-3 { grid-template-columns: 1fr; }
}
</style>
